# Copy to local .env file and edit the values for your environment.

DJANGO_SECRET_KEY=long-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://domain.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_LOG_LEVEL=INFO

# Local: omit to use SQLite. Production: Amazon RDS endpoint.
# DATABASE_URL=postgres://usuario:clave@mi-instancia.xxxx.us-east-1.rds.amazonaws.com:5432/ecommerce
# DB_SSLMODE=require

# S3 Production (S3). Without keys: EC2 uses the IAM role associated with the instance.
# AWS_STORAGE_BUCKET_NAME=mi-bucket-ecommerce
# AWS_S3_REGION_NAME=us-east-1

# Email (SMTP / Amazon SES)
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
